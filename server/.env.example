# ============================================================================
# Network Bandwidth Usage Anomaly Detection System
# Backend Environment Configuration Template
# ============================================================================

# Server Port (Render sets this dynamically in production)
PORT=5000

# MongoDB Connection URI
# Local development default:
# MONGODB_URI=mongodb://127.0.0.1:27017/network_bandwidth_detection

# MongoDB Atlas Production Template (Replace <username>, <password>, and <cluster-url>):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/network_bandwidth_detection?retryWrites=true&w=majority

# Optional: Frontend URL for strict CORS policies (optional; defaults to allowing all origins)
# CLIENT_URL=https://network-bandwidth-client.onrender.com
